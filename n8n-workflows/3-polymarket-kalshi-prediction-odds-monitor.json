{
  "name": "GMPSignal - Polymarket, Kalshi & Manifold Prediction Odds Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "schedule-trigger-1",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/gmpsignal~prediction-markets-polymarket-kalshi-scanner/run-sync-get-dataset-items",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "={{ $env.APIFY_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"platforms\": [\"polymarket\", \"kalshi\", \"manifold\"],\n  \"searchQuery\": \"\",\n  \"minLiquidityUsd\": 10000,\n  \"maxResults\": 45\n}"
      },
      "id": "apify-prediction-scanner-2",
      "name": "Run GMPSignal Prediction Markets Scanner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Run GMPSignal Prediction Markets Scanner",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
